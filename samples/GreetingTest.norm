import junit.jupiter.BeforeEach
import junit.jupiter.DisplayName
import junit.jupiter.Test
import junit.jupiter.assertionsAssertEquals
import junit.jupiter.assertionsAssertTrue

class GreetingTest {
  Integer calls

  GreetingTest() {
    calls = 0
  }

  @BeforeEach()
  Void prepare() {
    calls = calls + 1
  }

  @Test()
  @DisplayName(value: "runs a Norm method through JUnit Jupiter")
  Void formatsGreeting() {
    String greeting = "Hello, Norm"
    assertionsAssertEquals(arg0: 1, arg1: calls)
    assertionsAssertTrue(arg0: greeting.startsWith("Hello"))
  }
}

Module module() {
  module(dependencies: [dependency(repository: "github", name: "junit.jupiter", version: 7)])
}
